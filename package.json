    "docs:build:nado": "pnpm exec tsx scripts/docs-rag/cli.ts build",
    "docs:query:nado": "pnpm exec tsx scripts/docs-rag/cli.ts query"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@prisma/client": "^5.22.0",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tanstack/react-query": "^5.91.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.47.5",
    "wagmi": "^2.19.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
