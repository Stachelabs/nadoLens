# Copy this file to .env and fill in your values
# Never commit .env — it contains secrets

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Nado API endpoints
NADO_GATEWAY_REST=https://gateway.prod.nado.xyz/v1
NADO_ARCHIVE_REST=https://archive.prod.nado.xyz/v1
NADO_GATEWAY_V2=https://gateway.prod.nado.xyz/v2
NADO_ARCHIVE_V2=https://archive.prod.nado.xyz/v2
NEXT_PUBLIC_NADO_ARCHIVE_V1=https://archive.prod.nado.xyz/v1
NADO_SUBSCRIPTIONS_WS=wss://gateway.prod.nado.xyz/v1/subscribe

# WS Proxy (Railway)
WS_PROXY_URL=https://your-proxy.railway.app
NEXT_PUBLIC_WS_PROXY_URL=https://your-proxy.railway.app

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# --- Nado docs RAG (local sync / index; optional) ---
# Copy to .env or .env.local. See .claude/docs/NADO_DOCS_RAG.md

# Crawl
NADO_DOCS_BASE_URL=https://docs.nado.xyz
NADO_DOCS_CONCURRENCY=2
NADO_DOCS_MAX_RETRIES=4
NADO_DOCS_TIMEOUT_MS=45000
NADO_DOCS_MAX_DEPTH=32
NADO_DOCS_MAX_FAIL_RATIO=0.08
NADO_DOCS_DRY_RUN=0
NADO_DOCS_RESUME=0
NADO_DOCS_DRY_RUN_MAX_PAGES=5

# Chunking
NADO_DOCS_CHUNK_MAX_CHARS=2200

# Logging (debug|info|warn|error — default: info)
NADO_DOCS_LOG_LEVEL=info

# Embeddings (pnpm docs:index:nado)
NADO_DOCS_EMBED_BATCH_SIZE=12
NADO_DOCS_EMBED_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: OpenAI-compatible embeddings (re-index after switching)
# NADO_DOCS_EMBED_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Vitest: live docs integration tests (optional)
# NADO_DOCS_INTEGRATION=1
