# Copy this file to .env and fill in your values
# Never commit .env — it contains secrets

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Nado API endpoints
NADO_GATEWAY_REST=https://gateway.prod.nado.xyz/v1
NADO_ARCHIVE_REST=https://archive.prod.nado.xyz/v1
NADO_GATEWAY_V2=https://gateway.prod.nado.xyz/v2
NADO_ARCHIVE_V2=https://archive.prod.nado.xyz/v2
NEXT_PUBLIC_NADO_ARCHIVE_V1=https://archive.prod.nado.xyz/v1
NADO_SUBSCRIPTIONS_WS=wss://gateway.prod.nado.xyz/v1/subscribe

# WS Proxy (Railway)
WS_PROXY_URL=https://your-proxy.railway.app
NEXT_PUBLIC_WS_PROXY_URL=https://your-proxy.railway.app

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# --- Nado docs RAG (optional — non-secret config in scripts/docs-rag/nado-docs.config.ts) ---
# Only secrets belong here. All other RAG config lives in nado-docs.config.ts.

# Required only for OpenAI-compatible embeddings (NADO_DOCS_EMBED_PROVIDER=openai in config)
# OPENAI_API_KEY=

# Optional: override the Ollama/OpenAI provider at runtime
# NADO_DOCS_EMBED_PROVIDER=openai

# Vitest: live docs integration tests (optional)
# NADO_DOCS_INTEGRATION=1

# --- scripts/sync-nado-perp-svgs.ts only (never commit real codes) ---
# NADO_APP_REFERRAL_CODE=   # Private Beta on app.nado.xyz — same as ?join=CODE query value
# ICONS_SKIP_REFERRAL=1     # optional: skip gate if PLAYWRIGHT_CDP_URL uses an already-authorized profile
