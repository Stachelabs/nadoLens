# Copy this file to .env and fill in your values
# Never commit .env — it contains secrets

# Nado API endpoints
NADO_GATEWAY_REST=https://gateway.prod.nado.xyz/v1
NADO_ARCHIVE_REST=https://archive.prod.nado.xyz/v1
NADO_GATEWAY_V2=https://gateway.prod.nado.xyz/v2
NADO_ARCHIVE_V2=https://archive.prod.nado.xyz/v2
NEXT_PUBLIC_NADO_ARCHIVE_V1=https://archive.prod.nado.xyz/v1
NADO_SUBSCRIPTIONS_WS=wss://gateway.prod.nado.xyz/v1/subscribe

# Split-service proxies (Fly.io) — one IP per service = separate 429 buckets
NADO_MATCHES_SERVICE_URL=https://your-matches-service.fly.dev
NADO_FUNDING_SERVICE_URL=https://your-funding-service.fly.dev
SERVICE_SECRET=<32-char random hex — same value on Vercel and each Fly.io service>

# Upstash Redis (REST API — eu-central-1 Frankfurt recommended)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=<token from Upstash console>

# WS Proxy + Matches — co-located on nado-matches (Fly.io fra, min_machines_running=1)
# /sse  → WebSocket-to-SSE proxy (fill events per subaccount)
# /matches → Nado Archive proxy with Redis cache
WS_PROXY_URL=https://your-nado-matches-service.fly.dev
NEXT_PUBLIC_WS_PROXY_URL=https://your-nado-matches-service.fly.dev

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# --- Nado docs RAG (optional — non-secret config in scripts/docs-rag/nado-docs.config.ts) ---
# Only secrets belong here. All other RAG config lives in nado-docs.config.ts.

# Required only for OpenAI-compatible embeddings (NADO_DOCS_EMBED_PROVIDER=openai in config)
# OPENAI_API_KEY=

# Optional: override the Ollama/OpenAI provider at runtime
# NADO_DOCS_EMBED_PROVIDER=openai

# Vitest: live docs integration tests (optional)
# NADO_DOCS_INTEGRATION=1
